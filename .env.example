# ---------------------------------------------------------------------------
# Required: Gemini. Create a free key in Google AI Studio.
# https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=Alll....

# Optional. Any current Gemini model id. gemini-2.5-flash is the default and is
# the right balance for this workload. Use gemini-2.5-pro for dense material.
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Optional: Supabase accounts and cross-device history.
#
# Leave both blank and the app still works: progress is kept in localStorage
# on the device, and the sign-in control is hidden. Fill them in and students
# get real accounts, with anything recorded beforehand merged into the account
# on first sign-in.
#
# Project settings > Data API (URL) and Project settings > API keys (anon key).
# The anon key is safe to expose: row level security in supabase/schema.sql is
# what protects the rows.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
